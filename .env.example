# AI Provider ('gemini' or 'openai_compatible')
AI_PROVIDER=gemini

# Google Gemini API Key
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI-compatible API Provider (e.g. OpenAI, OpenRouter, vLLM, DeepSeek, Local LLM)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_or_provider_key_here
OPENAI_MODEL=gpt-4o-mini
